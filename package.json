{
  "name": "sds",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.7",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "serve": "bun run src/server/main.ts",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "cli": "bun run src/cli/main.ts",
    "release:tag": "sh scripts/release.sh tag",
    "release:push": "sh scripts/release.sh push",
    "release": "bun run release:tag && bun run release:push"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@effect/platform-bun": "^4.0.0-rc.112",
    "@fontsource-variable/geist": "^5.3.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.2.6",
    "effect": "^4.0.0-rc.112",
    "hono": "^4.13.7",
    "lucide-react": "^1.42.0",
    "nanoid": "^6.0.1",
    "proper-lockfile": "^4.1.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "shadcn": "^4.21.0",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/bun": "^1.4.2",
    "@types/proper-lockfile": "^4.1.4",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.2"
  },
  "bin": {
    "sds": "./src/cli/main.ts"
  }
}
